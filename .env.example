# ============================================================
# YantraGuard AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# IBM Cloud API Key (from IBM Cloud → Manage → Access → API Keys)
IBM_CLOUD_API_KEY=your_ibm_cloud_api_key_here

# IBM watsonx.ai Runtime (WML) service instance GUID
# Found at: IBM Cloud → Resource list → watsonx.ai Runtime service → Details
IBM_WATSON_ML_INSTANCE_ID=your_wml_instance_guid_here

# IBM watsonx.ai Runtime endpoint URL (us-south Dallas)
IBM_WATSON_ML_URL=https://us-south.ml.cloud.ibm.com

# Deployment Space ID
# Created in watsonx.ai Studio → Deployments → Spaces → your space → Manage → Details
IBM_SPACE_ID=your_deployment_space_guid_here

# Online Deployment ID
# Populated AFTER running the training notebook and creating the deployment.
# Found in watsonx.ai Studio → Deployments → your deployment → Details
IBM_DEPLOYMENT_ID=your_deployment_id_here
